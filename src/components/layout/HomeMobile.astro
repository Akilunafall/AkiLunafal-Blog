---
import CoverImage from "@components/common/CoverImage.astro";
import Icon from "@components/common/Icon.astro";
import type { CoverImageSource } from "@/types/cover-image";
import { homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { formatDateI18n } from "@/utils/date-utils";
import {
	countReadableCharacters,
	formatCompactNumber,
} from "@/utils/home-data-layer.js";
import { buildCoverImage } from "@/utils/cover-image";
import { getGuidePostSets } from "@/utils/home-guide-grid.js";
import { processCoverImageSync } from "@/utils/image-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagIndexUrl,
	url,
} from "@/utils/url-utils";

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const totalWords = posts.reduce(
	(sum, post) => sum + countReadableCharacters(post.body || ""),
	0,
);
const avgWords = posts.length > 0 ? Math.round(totalWords / posts.length) : 0;
const { pinned: pinnedPool, recent: recentPool } = getGuidePostSets(posts, 5);
const pinnedPosts = pinnedPool.slice(0, 3);
const timelinePosts = recentPool.slice(0, 5);
const mobilePostPool = Array.from(
	new Map(
		[...pinnedPosts, ...timelinePosts].map((post) => [post.id, post]),
	).values(),
);
const mobilePostItems: {
	id: string;
	title: string;
	category: string;
	date: string;
	href: string;
	cover: CoverImageSource | null;
	isPinned: boolean;
}[] = await Promise.all(
	mobilePostPool.map(async (post) => {
		const image = processCoverImageSync(post.data.image, post.id);
		const cover = image
			? await buildCoverImage({
					image,
					basePath: getFileDirFromPath(post.filePath || ""),
					widths: [240, 480],
					sizes: "(max-width: 768px) 28vw, 200px",
				})
			: null;
		return {
			id: post.id,
			title: post.data.title,
			category: post.data.category || i18n(I18nKey.uncategorized),
			date: formatDateI18n(post.data.published),
			href: getPostUrlBySlug(post.id),
			cover,
			isPinned: Boolean(post.data.pinned),
		};
	}),
);
const mobilePinnedItems = mobilePostItems.filter((post) => post.isPinned);
const mobileRecentItems = mobilePostItems
	.filter((post) => !post.isPinned)
	.slice(0, 5);
const topCategories = categories.slice(0, 4);
const topTags = tags.slice(0, 6);
const blindsConfig = homeConfig.homeBlinds;
const blindScenes = blindsConfig.enabled
	? [
			{
				...blindsConfig.scenes.composite,
				image: blindsConfig.reveal.backgroundImage,
			},
			...blindsConfig.scenes.items.slice(0, 4),
		]
	: [];
const contactItems = homeConfig.links.map((link) => ({
	name: link.name,
	icon: link.icon,
	href: link.url,
}));
const umamiConfig = siteConfig.analytics?.umamiAnalytics;
const statsBaseUrl =
	umamiConfig?.apiBase ||
	(umamiConfig?.scriptUrl ? new URL(umamiConfig.scriptUrl).origin : "");
const statsShareId = umamiConfig?.shareId ?? "";
---

<div
	class="home-mobile"
	id="home-mobile"
	data-stats-base-url={statsBaseUrl}
	data-stats-share-id={statsShareId}
>
	<section class="home-mobile-content">
		<section class="home-mobile-section">
			<header class="home-mobile-head" data-mobile-head>
				<h2 class="home-mobile-head__row" data-head-row>
					<span class="home-mobile-head__index">01</span>
					<span class="home-mobile-head__label">{i18n(I18nKey.siteData)}</span>
				</h2>
				<span class="home-mobile-head__en-mask">
					<span class="home-mobile-head__en" data-head-en>Statistics</span>
				</span>
				<span class="home-mobile-head__rule" data-head-rule />
			</header>
			<div class="home-mobile-stats-wrap">
				<div class="home-mobile-stats-popup" data-stats-popup role="dialog" aria-modal="false">
					<p class="home-mobile-stats-popup__value" data-popup-value>--</p>
					<p class="home-mobile-stats-popup__label" data-popup-label></p>
					<p class="home-mobile-stats-popup__detail" data-popup-detail></p>
				</div>
				<div class="home-mobile-stats" aria-label={i18n(I18nKey.siteData)}>
					<button class="home-mobile-stat" type="button" data-stat-key="uv" data-popup-value="--" data-popup-label={i18n(I18nKey.siteStatsVisitors)} data-popup-detail="数据来源 Umami · 建站起累计">
						<span class="home-mobile-stat__value" data-mobile-stat="UV">--</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.siteStatsVisitors)}</span>
					</button>
					<button class="home-mobile-stat" type="button" data-stat-key="pv" data-popup-value="--" data-popup-label={i18n(I18nKey.viewsLabel)} data-popup-detail="数据来源 Umami · 建站起累计">
						<span class="home-mobile-stat__value" data-mobile-stat="PV">--</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.viewsLabel)}</span>
					</button>
					<button class="home-mobile-stat" type="button" data-stat-key="posts" data-popup-value={String(posts.length)} data-popup-label={i18n(I18nKey.siteStatsPostCount)} data-popup-detail={`分类 ${categories.length} · 标签 ${tags.length} · 共 ${formatCompactNumber(totalWords)} 字`}>
						<span class="home-mobile-stat__value">{posts.length}</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.siteStatsPostCount)}</span>
					</button>
					<button class="home-mobile-stat" type="button" data-stat-key="cats" data-popup-value={String(categories.length)} data-popup-label={i18n(I18nKey.siteStatsCategoryCount)} data-popup-detail={i18n(I18nKey.categoryIndex)}>
						<span class="home-mobile-stat__value">{categories.length}</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.siteStatsCategoryCount)}</span>
					</button>
					<button class="home-mobile-stat" type="button" data-stat-key="tags" data-popup-value={String(tags.length)} data-popup-label={i18n(I18nKey.siteStatsTagCount)} data-popup-detail={i18n(I18nKey.tagIndex)}>
						<span class="home-mobile-stat__value">{tags.length}</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.siteStatsTagCount)}</span>
					</button>
					<button class="home-mobile-stat" type="button" data-stat-key="words" data-popup-value={totalWords.toLocaleString()} data-popup-label={i18n(I18nKey.wordCount)} data-popup-detail={`共 ${posts.length} 篇 · 平均约 ${avgWords.toLocaleString()} 字/篇`}>
						<span class="home-mobile-stat__value">{formatCompactNumber(totalWords)}</span>
						<span class="home-mobile-stat__label">{i18n(I18nKey.wordCount)}</span>
					</button>
				</div>
			</div>
		</section>

		<section class="home-mobile-section">
			<header class="home-mobile-head" data-mobile-head>
				<h2 class="home-mobile-head__row" data-head-row>
					<span class="home-mobile-head__index">02</span>
					<span class="home-mobile-head__label">{i18n(I18nKey.blogPosts)}</span>
				</h2>
				<span class="home-mobile-head__en-mask">
					<span class="home-mobile-head__en" data-head-en>Articles</span>
				</span>
				<span class="home-mobile-head__rule" data-head-rule />
			</header>
			{mobilePinnedItems.length > 0 ? (
				<div class="home-mobile-post-group">
					<h3 class="home-mobile-subhead">{i18n(I18nKey.pinnedPosts)}</h3>
					<div class="home-mobile-deck" data-mobile-deck>
						{mobilePinnedItems.map((post, index) => (
							<article class="home-mobile-deck__card" data-deck-card="" style={`--deck-index: ${index}`}>
								<div class="home-mobile-deck__card-inner">
									{post.cover ? (
										<CoverImage cover={post.cover} alt={post.title} class="home-mobile-deck__cover" loading="lazy" />
									) : <span class="home-mobile-deck__cover home-mobile-deck__cover--empty" aria-hidden="true" />}
									<span class="home-mobile-deck__meta">{post.category} · {post.date}</span>
									<a class="home-mobile-deck__link" href={post.href}>{post.title}</a>
								</div>
							</article>
						))}
					</div>
				</div>
			) : (
				<p class="home-mobile-empty">{i18n(I18nKey.noPinnedContent)}</p>
			)}
			{mobileRecentItems.length > 0 ? (
				<div class="home-mobile-post-group">
					<h3 class="home-mobile-subhead">{i18n(I18nKey.latestUpdates)}</h3>
					<ul class="home-mobile-post-list">
						{mobileRecentItems.map((post) => (
							<li class="home-mobile-post">
								<a class="home-mobile-post__link" href={post.href}>
									{post.cover ? (
										<CoverImage cover={post.cover} alt={post.title} class="home-mobile-post__cover" loading="lazy" />
									) : <span class="home-mobile-post__cover home-mobile-post__cover--empty" aria-hidden="true" />}
									<span class="home-mobile-post__body">
										<span class="home-mobile-post__title">{post.title}</span>
										<span class="home-mobile-post__meta">{post.category} · {post.date}</span>
									</span>
								</a>
						</li>
						))}
					</ul>
				</div>
			) : mobilePinnedItems.length === 0 ? (
				<p class="home-mobile-empty">{i18n(I18nKey.noPosts)}</p>
			) : null}
		</section>

		<section class="home-mobile-section">
			<header class="home-mobile-head" data-mobile-head>
				<h2 class="home-mobile-head__row" data-head-row>
					<span class="home-mobile-head__index">03</span>
					<span class="home-mobile-head__label">{i18n(I18nKey.contentIndex)}</span>
				</h2>
				<span class="home-mobile-head__en-mask">
					<span class="home-mobile-head__en" data-head-en>Explore</span>
				</span>
				<span class="home-mobile-head__rule" data-head-rule />
			</header>
			<div class="home-mobile-index">
				<section class="home-mobile-index__group">
					<h3 class="home-mobile-subhead">{i18n(I18nKey.categoryIndex)}</h3>
					<ul class="home-mobile-index__list">
						{topCategories.map((category) => (
							<li><a href={category.url}><span>{category.name}</span><span>{category.count}</span></a></li>
						))}
						<li><a class="home-mobile-index__all" href={url("/categories/")}><span>{i18n(I18nKey.viewAll)}</span><span>{categories.length}{i18n(I18nKey.categoryUnit)}</span></a></li>
					</ul>
				</section>
				<section class="home-mobile-index__group">
					<h3 class="home-mobile-subhead">{i18n(I18nKey.tagIndex)}</h3>
					<ul class="home-mobile-index__list">
						{topTags.map((tag) => (
							<li><a href={tag.url}><span>#{tag.name}</span><span>{tag.count}</span></a></li>
						))}
						<li><a class="home-mobile-index__all" href={getTagIndexUrl()}><span>{i18n(I18nKey.browseAllTags)}</span><span>{tags.length}{i18n(I18nKey.tagUnit)}</span></a></li>
					</ul>
				</section>
			</div>
		</section>

		<section class="home-mobile-section">
			<header class="home-mobile-head" data-mobile-head>
				<h2 class="home-mobile-head__row" data-head-row>
					<span class="home-mobile-head__index">04</span>
					<span class="home-mobile-head__label">{i18n(I18nKey.subscribeContact)}</span>
				</h2>
				<span class="home-mobile-head__en-mask">
					<span class="home-mobile-head__en" data-head-en>Contact</span>
				</span>
				<span class="home-mobile-head__rule" data-head-rule />
			</header>
			<ul class="home-mobile-links">
				{contactItems.map((link) => (
					<li>
						<a href={link.href} rel="noopener noreferrer" target={link.href.startsWith("http") ? "_blank" : undefined}>
							<Icon name={link.icon} is:inline />
							<span>{link.name}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		{blindScenes.length > 0 && (
			<section class="home-mobile-section" data-pagefind-ignore>
				<header class="home-mobile-head" data-mobile-head>
					<h2 class="home-mobile-head__row" data-head-row>
						<span class="home-mobile-head__index">05</span>
						<span class="home-mobile-head__label">影像故事</span>
					</h2>
					<span class="home-mobile-head__en-mask">
						<span class="home-mobile-head__en" data-head-en>Moments</span>
					</span>
					<span class="home-mobile-head__rule" data-head-rule />
				</header>
				<div class="home-mobile-story-intro">
					<strong>{blindsConfig.reveal.headline.title}</strong>
					{blindsConfig.reveal.headline.messages.map((message) => <span>{message}</span>)}
				</div>
				<div class="home-mobile-stories">
					{blindScenes.map((scene) => (
						<article class="home-mobile-story">
							<img src={scene.image} alt={scene.alt} loading="lazy" decoding="async" />
							<div class="home-mobile-story__body">
								<div class="home-mobile-story__heading">
									<h3>{scene.title}</h3>
									{scene.date && <time>{scene.date}</time>}
								</div>
								{scene.description && <p>{scene.description}</p>}
							</div>
						</article>
					))}
				</div>
			</section>
		)}

	</section>
</div>

<script is:inline>
	// 预绘阶段标记入场动画，避免内容闪现；reduced-motion / 桌面端不标记
	(() => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		if (!window.matchMedia("(max-width: 768px)").matches) return;
		const root = document.currentScript?.previousElementSibling;
		if (root?.id === "home-mobile") root.classList.add("is-anim");
	})();
</script>

<script>
	import { createCache } from "@/utils/cache-utils";
	import { formatCompactNumber } from "@/utils/home-data-layer.js";
	import { bindHomeLayer } from "@/utils/home-lifecycle";

	type Cleanup = () => void;
	type ShareData = { websiteId: string; token: string };

	let cleanups: Cleanup[] = [];
	let mobileGeneration = 0;

	function cleanupHomeMobile() {
		// 同一 DOM 的断点重建也必须立即作废尚未完成的 import。
		mobileGeneration += 1;
		cleanups.reverse().forEach((cleanup) => cleanup());
		cleanups = [];
	}

	function initVisitStats(root: HTMLElement) {
		const statsBaseUrl = root.dataset.statsBaseUrl;
		const statsShareId = root.dataset.statsShareId;
		if (!statsBaseUrl || !statsShareId) return;
		const valueNodes = root.querySelectorAll<HTMLElement>("[data-mobile-stat]");
		if (valueNodes.length === 0) return;
		const controller = new AbortController();
		const { signal } = controller;
		cleanups.push(() => controller.abort());
		// 持久缓存仍跨挂载共享；进行中的请求只属于本次挂载，避免复用已中止的 Promise。
		const shareCache = createCache<ShareData>({
			key: "umami_share_data",
			ttl: 3_600_000,
		});
		shareCache
			.fetch(async () => {
				const response = await fetch(`${statsBaseUrl}/api/share/${statsShareId}`, { signal });
				if (!response.ok) throw new Error("获取 Umami 分享信息失败");
				const share: {
					websiteId?: string;
					entityId?: string;
					token?: string;
				} = await response.json();
				signal.throwIfAborted();
				const websiteId = share.websiteId || share.entityId;
				if (!websiteId) throw new Error("Umami 分享信息缺少 websiteId");
				return { websiteId, token: share.token || statsShareId };
			})
			.then(({ websiteId, token }) =>
				fetch(
					`${statsBaseUrl}/api/websites/${websiteId}/stats?startAt=0&endAt=${Date.now()}`,
					{
						signal,
						headers: {
							"x-umami-share-token": token,
							"x-umami-share-context": "1",
							"Content-Type": "application/json",
						},
					},
				),
			)
			.then((response) => {
				if (!response.ok) throw new Error("获取 Umami 统计信息失败");
				return response.json();
			})
			.then((data: { uv?: number; visitors?: number; pv?: number; pageviews?: number }) => {
				if (signal.aborted || !root.isConnected) return;
				const uvRaw = data.uv ?? data.visitors ?? 0;
				const pvRaw = data.pv ?? data.pageviews ?? 0;
				valueNodes.forEach((node) => {
					const isUv = node.dataset.mobileStat === "UV";
					const raw = isUv ? uvRaw : pvRaw;
					node.textContent = formatCompactNumber(raw);
					const button = node.closest<HTMLElement>("[data-stat-key]");
					if (button) {
						button.dataset.popupValue = Number(raw).toLocaleString();
					}
				});
			})
			.catch(() => {
				if (signal.aborted || !root.isConnected) return;
				valueNodes.forEach((node) => {
					node.textContent = "--";
					const button = node.closest<HTMLElement>("[data-stat-key]");
					if (button) button.dataset.popupValue = "--";
				});
			});
	}

	function initStatPopups(root: HTMLElement) {
		const popup = root.querySelector<HTMLElement>("[data-stats-popup]");
		const buttons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-stat-key]"),
		);
		if (!popup || buttons.length === 0) return;
		const valueNode = popup.querySelector<HTMLElement>("[data-popup-value]");
		const labelNode = popup.querySelector<HTMLElement>("[data-popup-label]");
		const detailNode = popup.querySelector<HTMLElement>("[data-popup-detail]");
		if (!valueNode || !labelNode || !detailNode) return;

		let openKey: string | null = null;
		const close = () => {
			popup.classList.remove("is-open");
			openKey = null;
		};
		const onStatClick = (event: MouseEvent) => {
			const button = (event.target as Element).closest<HTMLElement>(
				"[data-stat-key]",
			);
			if (!button) return;
			const key = button.dataset.statKey ?? "";
			if (openKey === key) {
				close();
				return;
			}
			valueNode.textContent = button.dataset.popupValue ?? "--";
			labelNode.textContent = button.dataset.popupLabel ?? "";
			detailNode.textContent = button.dataset.popupDetail ?? "";
			popup.classList.add("is-open");
			openKey = key;
		};
		const onOutsideClick = (event: MouseEvent) => {
			const target = event.target as Element | null;
			if (!target) return;
			if (popup.contains(target) || target.closest("[data-stat-key]")) return;
			close();
		};
		const onKeyDown = (event: KeyboardEvent) => {
			if (event.key === "Escape") close();
		};

		root.addEventListener("click", onStatClick);
		document.addEventListener("click", onOutsideClick);
		document.addEventListener("keydown", onKeyDown);
		cleanups.push(() => {
			root.removeEventListener("click", onStatClick);
			document.removeEventListener("click", onOutsideClick);
			document.removeEventListener("keydown", onKeyDown);
			close();
			popup.getAnimations().forEach((animation) => animation.cancel());
		});
	}

	function initDeck(root: HTMLElement) {
		const deck = root.querySelector<HTMLElement>("[data-mobile-deck]");
		if (!deck) return;
		const cards = Array.from(deck.querySelectorAll<HTMLElement>("[data-deck-card]"));
		if (cards.length < 2) return;

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const SWIPE_THRESHOLD = 56;
		const CYCLE_MS = 420;
		const AUTO_INTERVAL = 5000;
		const order = cards.slice();
		let busy = false;
		let autoTimer = 0;
		let cycleTimer: number | undefined;
		let isDisposed = false;
		let isInView = false;
		let isHovered = window.matchMedia("(hover: hover)").matches && deck.matches(":hover");
		let isFocused = deck.contains(document.activeElement);

		const topCard = () => order[0];

		const applyLayout = () => {
			order.forEach((card, index) => {
				card.style.setProperty("--deck-index", String(index));
			});
		};

		/** 翻页（传送带循环）：顶部卡沉到堆底 z 轴，沿堆叠路径向下滑入底层，其余卡上移补位 */
		const advance = () => {
			if (busy || isDisposed) return;
			busy = true;
			const top = topCard();
			const lastIndex = order.length - 1;
			// 清除拖拽内联位移，交回 CSS 变量驱动过渡；z 轴立即沉底 = 从其余卡背后滑过
			top.style.transform = "";
			top.classList.add("is-cycling");
			top.style.setProperty("--deck-index", String(lastIndex));
			order.slice(1).forEach((card, index) => {
				card.style.setProperty("--deck-index", String(index));
			});
			const finishCycle = () => {
				cycleTimer = undefined;
				top.classList.remove("is-cycling");
				order.shift();
				order.push(top);
				busy = false;
			};
			if (reduceMotion) finishCycle();
			else cycleTimer = window.setTimeout(finishCycle, CYCLE_MS);
		};

		const stopAuto = () => {
			window.clearInterval(autoTimer);
			autoTimer = 0;
		};
		const syncAuto = () => {
			if (isDisposed || reduceMotion || !isInView || document.visibilityState !== "visible" || isHovered || isFocused || dragging) {
				stopAuto();
				return;
			}
			if (!autoTimer) autoTimer = window.setInterval(advance, AUTO_INTERVAL);
		};

		// —— 拖拽翻页 ——
		let dragging = false;
		let startY = 0;
		let startT = 0;
		let lastDeltaY = 0;
		let lastVelocity = 0;
		let suppressClick = false;

		const onTouchStart = (event: TouchEvent) => {
			if (busy || event.touches.length !== 1) return;
			dragging = true;
			startY = event.touches[0].clientY;
			startT = performance.now();
			lastDeltaY = 0;
			lastVelocity = 0;
			topCard().style.transition = "none";
			stopAuto();
		};
		const onTouchMove = (event: TouchEvent) => {
			if (!dragging) return;
			// 阻止拖拽卡片时页面跟随滚动
			if (event.cancelable) event.preventDefault();
			const deltaT = performance.now() - startT;
			const deltaY = event.touches[0].clientY - startY;
			if (deltaT > 0) {
				lastVelocity = ((deltaY - lastDeltaY) / deltaT) * 1000;
				startT = performance.now();
				lastDeltaY = deltaY;
			}
			topCard().style.transform = `translateY(${deltaY}px) scale(1)`;
		};
		const onTouchEnd = () => {
			if (!dragging) return;
			dragging = false;
			const top = topCard();
			top.style.transition = "";
			top.style.transform = "";
			if (Math.abs(lastDeltaY) > SWIPE_THRESHOLD || Math.abs(lastVelocity) > 500) {
				suppressClick = true;
				advance();
			}
			syncAuto();
		};
		const onClickCapture = (event: MouseEvent) => {
			if (!suppressClick) return;
			suppressClick = false;
			if ((event.target as Element).closest("a")) event.preventDefault();
		};

		const onPointerEnter = (event: PointerEvent) => {
			if (event.pointerType === "touch") return;
			isHovered = true;
			syncAuto();
		};
		const onPointerLeave = (event: PointerEvent) => {
			if (event.pointerType === "touch") return;
			isHovered = false;
			syncAuto();
		};
		const onFocusIn = () => { isFocused = true; syncAuto(); };
		const onFocusOut = (event: FocusEvent) => {
			isFocused = event.relatedTarget instanceof Node && deck.contains(event.relatedTarget);
			syncAuto();
		};
		const visibilityObserver = new IntersectionObserver((entries) => {
			if (isDisposed) return;
			for (const entry of entries) isInView = entry.isIntersecting;
			syncAuto();
		});

		deck.addEventListener("touchstart", onTouchStart, { passive: true });
		deck.addEventListener("touchmove", onTouchMove, { passive: false });
		deck.addEventListener("touchend", onTouchEnd);
		deck.addEventListener("touchcancel", onTouchEnd);
		deck.addEventListener("click", onClickCapture, true);
		deck.addEventListener("pointerenter", onPointerEnter);
		deck.addEventListener("pointerleave", onPointerLeave);
		deck.addEventListener("focusin", onFocusIn);
		deck.addEventListener("focusout", onFocusOut);
		document.addEventListener("visibilitychange", syncAuto);
		applyLayout();
		visibilityObserver.observe(deck);
		cleanups.push(() => {
			isDisposed = true;
			stopAuto();
			if (cycleTimer !== undefined) window.clearTimeout(cycleTimer);
			visibilityObserver.disconnect();
			document.removeEventListener("visibilitychange", syncAuto);
			deck.removeEventListener("touchstart", onTouchStart);
			deck.removeEventListener("touchmove", onTouchMove);
			deck.removeEventListener("touchend", onTouchEnd);
			deck.removeEventListener("touchcancel", onTouchEnd);
			deck.removeEventListener("click", onClickCapture, true);
			deck.removeEventListener("pointerenter", onPointerEnter);
			deck.removeEventListener("pointerleave", onPointerLeave);
			deck.removeEventListener("focusin", onFocusIn);
			deck.removeEventListener("focusout", onFocusOut);
			cards.forEach((card, index) => {
				card.classList.remove("is-cycling");
				card.style.transform = "";
				card.style.transition = "";
				card.style.setProperty("--deck-index", String(index));
				card.getAnimations().forEach((animation) => animation.cancel());
			});
		});
	}

	/** 分区标题与置顶文章牌堆的滚动入场 */
	async function initEntrance(root: HTMLElement, generation: number): Promise<void> {
		let revertEntrance: Cleanup | undefined;
		try {
			const [{ gsap }, { ScrollTrigger }] = await Promise.all([
				import("gsap"),
				import("gsap/ScrollTrigger"),
			]);
			if (generation !== mobileGeneration || !root.isConnected) return;
			gsap.registerPlugin(ScrollTrigger);
			const q = gsap.utils.selector(root);
			// gsap 3.15 起 context() 首参为空时返回 ambient context 而非新建实例，
			// 必须传函数；与 home-hero-controller 的写法保持一致。
			const ctx = gsap.context(() => {}, root);
			revertEntrance = () => ctx.revert();
			// 先登记清理，初始化中途失败也能撤销已创建的动画和 ScrollTrigger。
			cleanups.push(revertEntrance);
			ctx.add(() => {
				gsap.set(q(".home-mobile-head__en"), { yPercent: 110, y: 0, skewY: 4 });
				// 分区标题：英文大字遮罩进场，再带出行标签与下划线。
				q("[data-mobile-head]").forEach((head) => {
					const en = head.querySelector(".home-mobile-head__en");
					const row = head.querySelector(".home-mobile-head__row");
					const rule = head.querySelector(".home-mobile-head__rule");
					const t = gsap.timeline({
						scrollTrigger: { trigger: head, start: "top 85%", once: true },
					});
					if (en)
						t.to(
							en,
							{ yPercent: 0, skewY: 0, duration: 1.15, ease: "expo.out" },
							0,
						);
					if (row)
						t.to(
							row,
							{ x: 0, opacity: 1, duration: 0.8, ease: "power3.out" },
							0.35,
						);
					if (rule)
						t.to(
							rule,
							{ scaleX: 1, duration: 0.9, ease: "expo.out" },
							0.4,
						);
				});

				// 牌堆外壳保留触控翻页位移，入场动画只作用于内层。
				const deck = root.querySelector<HTMLElement>("[data-mobile-deck]");
				if (deck) {
					gsap.to(q(".home-mobile-deck__card-inner"), {
						y: 0,
						opacity: 1,
						scale: 1,
						duration: 1.05,
						ease: "expo.out",
						stagger: 0.09,
						scrollTrigger: { trigger: deck, start: "top 82%", once: true },
					});
				}
			});
		} catch {
			if (generation !== mobileGeneration || !root.isConnected) return;
			// GSAP 加载或初始化失败时撤销半成品并解除隐藏，不影响下一次挂载。
			revertEntrance?.();
			root.classList.remove("is-anim");
		}
	}

	async function initHomeMobile(): Promise<void> {
		cleanupHomeMobile();
		const root = document.getElementById("home-mobile");
		if (!root) return;
		const generation = mobileGeneration;
		cleanups.push(() => {
			root.classList.remove("is-anim");
			root.getAnimations({ subtree: true }).forEach((animation) => animation.cancel());
		});
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		root.classList.toggle("is-anim", !reduceMotion);
		initVisitStats(root);
		initStatPopups(root);
		initDeck(root);
		// 只等待模块加载与动画登记，不等待入场时间轴或滚动动画播放结束。
		if (!reduceMotion) await initEntrance(root, generation);
	}

	// 同 HomeDataLayer：容器替换前清理（bindHomeLayer 内部走 astro:before-swap），
	// 旧的 swup:willReplaceContent 是 swup 3 的名字，在 swup 4 下不会触发
	bindHomeLayer("mobile", { media: "(max-width: 768px)", boot: initHomeMobile, teardown: cleanupHomeMobile });
</script>
